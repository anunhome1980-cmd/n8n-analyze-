    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Placeholder ML / analysis step (native Python runner).\n# Detects missing values, duplicates, outliers and summary statistics.\n# NOTE: native Python uses _items (all-items mode) and bracket access.\nrows = []\nfor item in _items:\n    j = item[\"json\"]\n    rows.append(dict(j))\n\ncolumns = []\nfor r in rows:\n    for k in r.keys():\n        if k not in columns:\n            columns.append(k)\n\ntotal_rows = len(rows)\n\n# Missing values per column\nmissing = {}\nfor c in columns:\n    cnt = 0\n    for r in rows:\n        v = r.get(c, None)\n        if v is None or (isinstance(v, str) and v.strip() == \"\"):\n            cnt += 1\n    missing[c] = cnt\n\n# Duplicate rows (full-row match)\nseen = []\ndup_count = 0\nfor r in rows:\n    key = tuple((c, r.get(c, None)) for c in columns)\n    if key in seen:\n        dup_count += 1\n    else:\n        seen.append(key)\n\ndef to_num(v):\n    if isinstance(v, bool):\n        return None\n    if isinstance(v, (int, float)):\n        return float(v)\n    if isinstance(v, str):\n        s = v.strip().replace(\",\", \"\")\n        try:\n            return float(s)\n        except Exception:\n            return None\n    return None\n\ndef percentile(sorted_vals, p):\n    n = len(sorted_vals)\n    if n == 1:\n        return sorted_vals[0]\n    idx = p * (n - 1)\n    lo = int(idx)\n    hi = min(lo + 1, n - 1)\n    frac = idx - lo\n    return sorted_vals[lo] + (sorted_vals[hi] - sorted_vals[lo]) * frac\n\nsummary = {}\noutliers = {}\nfor c in columns:\n    nums = []\n    for r in rows:\n        num = to_num(r.get(c, None))\n        if num is not None:\n            nums.append(num)\n    # treat as numeric column only if at least half the rows parse as numbers\n    if len(nums) >= 1 and len(nums) >= (total_rows / 2.0):\n        srt = sorted(nums)\n        n = len(srt)\n        mean = sum(srt) / n\n        q1 = percentile(srt, 0.25)\n        q3 = percentile(srt, 0.75)\n        iqr = q3 - q1\n        lower = q1 - 1.5 * iqr\n        upper = q3 + 1.5 * iqr\n        out = [x for x in nums if x < lower or x > upper]\n        summary[c] = {\n            \"count\": n,\n            \"min\": round(srt[0], 4),\n            \"max\": round(srt[-1], 4),\n            \"mean\": round(mean, 4),\n            \"median\": round(percentile(srt, 0.5), 4),\n        }\n        outliers[c] = len(out)\n\nresult = {\n    \"total_rows\": total_rows,\n    \"columns\": columns,\n    \"missing_values\": missing,\n    \"total_missing\": sum(missing.values()),\n    \"duplicate_rows\": dup_count,\n    \"numeric_summary\": summary,\n    \"outliers\": outliers,\n    \"chart_labels\": columns,\n    \"chart_values\": [missing[c] for c in columns],\n}\n\nreturn [{\"json\": result}]\n"
      },
